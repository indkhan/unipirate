# Supabase — Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# PostHog (optional in dev — analytics are skipped when unset)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Resend (optional in dev — only needed for emails)
RESEND_API_KEY=re_xxx

# OpenRouter (optional in dev — only needed for the course-import AI fallback)
OPENROUTER_API_KEY=sk-or-xxx

# Tavily (optional — assistant web_search tool degrades gracefully when unset)
TAVILY_API_KEY=tvly-xxx
