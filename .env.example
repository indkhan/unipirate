# Supabase — copy to .env.local and fill with your project values.
# Project URL + anon key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose with NEXT_PUBLIC_.
# Used by scripts/seed.mjs and admin tooling.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
