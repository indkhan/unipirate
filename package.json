    "eval:assistant": "tsx --env-file=.env.local scripts/eval-assistant.ts",
    "db:types": "supabase gen types typescript --linked > lib/db/database.types.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.16",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.0",
    "ai": "^7.0.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "posthog-js": "^1.235.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "shadcn": "^4.12.0",
    "supabase": "^2.109.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^3.1.0"
  }
